# ==========================================
# CONFIGURACIÓN DEL PROVEEDOR DE IA (LLM)
# ==========================================
# Proveedor inicial: OpenRouter (acceso a cualquier modelo con una sola API Key)
LLM_PROVIDER=OPENROUTER

# Modelo por defecto para OpenRouter (Debe soportar Tool Calling / Function Calling)
# Opciones recomendadas: openai/gpt-4o, google/gemini-2.5-flash, anthropic/claude-3.5-sonnet
OPENROUTER_MODEL=openai/gpt-4o

# Si usas otro proveedor, configura su modelo aquí (opcional)
OPENAI_MODEL=gpt-4o
GOOGLE_MODEL=gemini-1.5-pro
GROQ_MODEL=llama-3.3-70b-versatile

# ==========================================
# API KEYS (SECRETOS)
# ==========================================
# Obtén tu API Key en: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-tu_api_key_aqui

# Si decides cambiar de proveedor, descomenta y rellena la que corresponda:
# OPENAI_API_KEY=sk-proj-tu_api_key_aqui
# GOOGLE_API_KEY=tu_api_key_de_google_ai_studio
# GROQ_API_KEY=gsk_tu_api_key_de_groq

# ==========================================
# CONFIGURACIÓN ADICIONAL
# ==========================================
LOG_LEVEL=INFO